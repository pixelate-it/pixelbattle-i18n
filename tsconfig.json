{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,

        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["scripts"]
}
